<style>
.inov-secoes {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: #222;
}
.inov-secoes .logo {
  display: block;
  margin: 0 auto 24px auto;
 
}
.inov-secoes h2 {
  color: #2176bf;
  font-size: 22px;

<style>
.CardCatTitle {
  font-size: 1.5rem;
  color: ;
  font-weight: bold;
  font-family: Arial, Helvetica, sans-serif;
  margin: 38px 0 15px 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.CardDescGrid {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  justify-content: center;
  margin-bottom: 10px;
}
.CardDesc {
  background: linear-gradient(135deg, #e6f0fa 60%, #fff 100%);
  border-radius: 13px;
  border: 1px solid #a5c7e6;
  box-shadow: 0 2px 11px #2176bf1a;
  padding: 19px 29px 15px 29px;
  min-width: 250px;
  max-width: 280px;
  text-align: left;
  transition: box-shadow .16s, transform .12s;
}
.CardDesc:hover {
  box-shadow: 0 8px 24px #2176bf25;
  transform: translateY(-4px) scale(1.03);
}
.CardDesc a {
  color: #2176bf;
  font-size: 17px;
  font-weight: bold;
  text-decoration: none;
  margin-bottom: 6px;
  display: inline-block;
}
.CardDesc .sub {
  color: #61677d;
  font-size: 14px;
  margin-top: 2px;
}


.card-apresentacao {
  font-family: Arial, Helvetica, sans-serif;
  background: #fafdff;
  border-radius: 12px;
  border: 1px solid #e1e9f2;
  box-shadow: 0 2px 10px #1e73be18;
  padding: 26px 34px 24px 34px;
  margin-bottom: 20px;
}
.card-apresentacao .titulo {
  color: #1e73be;
  font-size: 1.7rem;
  margin-bottom: 18px;
  font-weight: bold;
}
.card-apresentacao .subtitulo {
  font-size: 14.5pt;
  color: #1e73be;
  font-weight: bold;
  margin-bottom: 10px;
}
.card-apresentacao p {
  text-align: justify;
  font-size: 12pt;
  margin: 0 0 8px 0;
}
.card-apresentacao .observacao {
  font-size: 12pt;
  margin-bottom: 10px;
}
.card-apresentacao .destaque {
  color: black;
  font-weight: bold;
}
.card-apresentacao .destaque2 {
  color: #c0392b;
}
.card-apresentacao a {
  color: #2176bf;
  text-decoration: underline;
}
.card-apresentacao hr {
  border-top: 1px dashed #98c4e6;
  margin: 20px 0 18px 0;
}





.scrollable-table {
  overflow-x: auto;
  margin-bottom: 24px;
}


.scrollable-table table {
  border-collapse: separate;
  border-spacing: 0;
border: 2px solid #a5c7e6;
  max-width: 820px;
  min-width: 600px;
  font-size: 15px;
  background: #fff;
  font-family: Arial, Helvetica, sans-serif;
  color: #222;
  box-shadow: 0 2px 20px #2176bf11;
  border-radius: 12px;
  overflow: hidden;
}


.scrollable-table th {
  background: #e6f0fa;
  color: #1e4491;
  padding: 14px 8px;
  font-size: 17px;
  font-weight: bold;
  border-bottom: 2px solid #2176bf25;
  text-align: center;
  vertical-align: middle;
}

.scrollable-table tr {
  transition: background .15s;
}
.scrollable-table tr:hover {
  background: #f3f8fc;
}


.scrollable-table td {
  padding: 13px 10px;
  border-bottom: 1px solid #e5eff7;
  text-align: center;
  vertical-align: middle;
}


.scrollable-table td:first-child {
  text-align: left;
  font-weight: 500;
  color: #205c97;
  background: #fafdff;
  min-width: 240px;
}


.scrollable-table td img {
  height: 24px !important;
  width: 24px !important;
  object-fit: contain;
  vertical-align: middle;
}


@media (max-width: 750px) {
  .scrollable-table table {
    font-size: 14px;
    min-width: 600px;
  }
  .scrollable-table th, .scrollable-table td { padding: 9px 6px; }
}


.scrollable-table tr:last-child td {
  border-bottom: none;
}

.MenuBlocosGrid {
  display: flex;
  flex-wrap: nowrap; 
  justify-content: center;
  align-items: stretch;
  gap: 28px;
  margin: 25px 0 40px 0;
}

.MenuBloco {
  background: linear-gradient(to bottom right, #fafdff, #e6f0fb 92%);
  border-radius: 16px;
  border: 2px solid #d6e6f8;
  box-shadow: 0 2px 14px #2176bf12;
  padding: 32px 26px 24px 26px;
  width: 250px;
  height: 220px;
  text-align: center;
  font-family: Arial, Helvetica, sans-serif;
  color: #1e73be;
  font-weight: bold;
  font-size: 1.04rem;
  text-decoration: none;
  transition: box-shadow .15s, transform .12s, background .16s;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.MenuBloco:hover {
  background: linear-gradient(to bottom right, #f1f8ff, #ddeaf8 100%);
  box-shadow: 0 6px 24px #2176bf25;
  transform: translateY(-3px) scale(1.045);
  color: #2176bf;
}

.MenuBloco img {
  height: 42px;
  margin-bottom: 12px;
  display: block;
 	
}

.MenuBloco img[alt="Serviço de Ouvidoria"]{
    width: 59px;    
    height: 59px;   
    max-width: unset; 
}
.MenuBloco img[alt="Serviços de Informação ao Cidadão - SIC"]{
    margin-left:5px;
}


@media (max-width: 1250px) {
  .MenuBlocosGrid {
    flex-wrap: wrap;
    gap: 18px;
  }
  .MenuBloco {
    width: 220px;
    height: 220px;
  }
}
@media (max-width: 900px) {
  .MenuBlocosGrid {
    flex-direction: column;
    align-items: center;
  }
  .MenuBloco {
    width: 95vw;
    max-width: 400px;
    height: 170px;
  }
}






























@media (max-width: 900px) {
  .CardDescGrid { justify-content: center; }
}
@media (max-width: 650px) {
  .CardDescGrid { flex-direction: column; align-items: center; }

<style>
.ouvidoria-opiniao-card {
  background: #fafdff;
  border: 1.5px solid #1e73be;
  border-radius: 16px;
  box-shadow: 0 2px 12px #1e73be13;
  padding: 24px 30px 16px 30px;
  margin-bottom: 16px;
  font-family: Arial, Helvetica, sans-serif;

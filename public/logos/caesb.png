<!-- start Simple Custom CSS and JS -->
<style>
/* Estilização Geral */
.mapa-site {
    font-family: Arial, sans-serif;
    color: #333;
    padding: 20px;
    max-width: 800px;
    margin: 0 auto;
    
    border-radius: 8px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
}

/* Estilo dos Blocos */
.mapa-site ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

.mapa-site li {
    margin: 10px 0;
    padding: 12px 15px;
    background-color: #ffffff;
    border: 1px solid #ddd;
    border-radius: 5px;
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, background-color 0.3s ease;
    text-align: center;
    font-size: 15px;
}

/* Hierarquia */
.mapa-site ul ul {
    margin-left: 20px;
    padding-left: 0;
}

.mapa-site ul ul li {
    text-align: left;
    font-size: 14px;
    border-left: 4px solid #007BFF;
    padding-left: 10px;
    
}

/* Hover Effects */
.mapa-site li:hover {
    background-color: #e6f4ff;
    border-color: #007BFF;
    transform: translateY(-2px);
}

/* Links */
.mapa-site a {
    text-decoration: none;
    color: #007BFF;
    font-weight: bold;
}

.mapa-site a:hover {
    color: #0056b3;
    text-decoration: underline;
}

/* Ajustando Hierarquias Aninhadas */
.mapa-site ul ul ul li {
    border-left: 4px dashed #007BFF;
    background-color: #eff7ff;
    font-size: 13px;
}

/* Responsividade */
@media (max-width: 768px) {
    .mapa-site {
        padding: 15px;
    }

    .mapa-site li {
        font-size: 14px;
        padding: 10px;
    }

    .mapa-site ul ul li {
        font-size: 13px;
    }

    .mapa-site ul ul ul li {
        font-size: 12px;
    }
}

/* Acessibilidade: Foco nos Links */
.mapa-site a:focus {
    outline: 2px dashed #007BFF;
    outline-offset: 4px;
}
</style>
<!-- end Simple Custom CSS and JS -->

<!-- start Simple Custom CSS and JS -->
<style>

.carta {
	display: grid;
	grid-template-columns: repeat(5, 1fr);
	gap: 20px;
	width: 100%;
}
.card {
	background: linear-gradient(45deg, #0b3ecd, #0b3ecd);
	color: white;
	text-align: center;
	border-radius: 8px;
	transition: transform 0.3s;
	display: block;
	/* Troquei para block para testar */
	overflow: hidden;
	position: relative;
}
.card img {
	display: block;
	/* Garante que a imagem seja um bloco acima do texto */
	width: 50px;
	height: 50px;
	margin: 0 auto 15px auto;
	/* Centraliza a imagem */
	color:white;
	margin-top: 40px;
}
.card img[src="https://s3.caesb.df.gov.br/www/prod/site1/2024/09/Logo_participa_Horizontal-APENAS-LOGO.png"] {
	width: 70px;
    height: 55px;
	
	color:white;
	margin-top: 40px;
}
.card p {
	font-size: 1rem;
	font-weight: bold;
	margin-top: 40px;
	display: block;
	/* Garante que o parágrafo seja um bloco abaixo da imagem */
	text-align: center;
}
.card:hover {
	background-color: #0b4b7a;
	transform: scale(1.05);
	color: White;
}
.card.active {
	background: linear-gradient(45deg, #28bbb6, #28bbb6);
	transform: scale(1.05);
}
.card-content {
	margin-top: 20px;
	padding: 20px;
	display: none;
}
.card-content.active {
	display: block;
	/* O conteúdo ativo será mostrado */
}
.wp-block .card-content {
	display: block !important;
}
.footer {
	margin-top: 20px;
	padding: 20px;
}
.tituloo {
	font-family: Arial, Helvetica, sans-serif;
	font-size: 36px;
	text-align: center;
	color: #333;
	margin-bottom: 50px;
	font-weight: bold;
}
.divider {
	border: none;
	height: 2px;
	background-color: #0c0d0e;
	margin-top: 40px;
	margin-bottom: 40px;
}
.testecard {
	width: 300px;
	padding: 20px;
	border-radius: 8px;
	background: linear-gradient(45deg, #003366, #006699);
	box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
	text-align: center;
	transition: transform 0.3s ease;
}
.testecard:hover {
	transform: translateY(-10px);
	box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
}

.CardSer {
	width: 150px;
    padding: 10px 20px 10px 20px;
	border-radius: 8px;
	background: linear-gradient(45deg, #003366, #006699);
	box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
	text-align: center;
	transition: transform 0.3s ease;
}
.CardSer:hover {
	transform: translateY(-10px);
	box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
}

.scrollable-table {
   
   overflow-y: auto;
    overflow-x: auto;  /* Ativa a barra de rolagem horizontal, se necessário */
}



/* Responsividade para tablets (tela entre 768px e 1024px) */
@media (max-width: 1024px) {
	.carta {
		grid-template-columns: repeat(3, 1fr);
	}
}
/* Responsividade para telas menores (entre 600px e 768px) */
@media (max-width: 768px) {
	.carta {
		grid-template-columns: repeat(2, 1fr);
	}
	.card img {
		width: 50px;
		height: 50px;
	}
}
/* Responsividade para dispositivos móveis (menos de 600px) */
@media (max-width: 600px) {
	.carta {
		grid-template-columns: 1fr;
	}
	.card img {
		width: 35px;
		height: 35px;
	}
	.card p {
		font-size: 0.9rem;
	}
}
@media (max-width: 1024px) {
	.carta {
		grid-template-columns: repeat(3, 1fr);
		gap: 15px;
	}
}
/* Responsividade para telas menores (entre 600px e 768px) */
@media (max-width: 768px) {
	.carta {
		grid-template-columns: repeat(2, 1fr);
		gap: 15px;
	}
	.card {
		padding: 15px;
	}
	.card img {
		width: 50px;
		height: 50px;
	}
}
/* Responsividade para dispositivos móveis (menos de 600px) */
@media (max-width: 600px) {
	.carta {
		grid-template-columns: 1fr;
		gap: 10px;
	}
	.card {
		padding: 10px;
	}
	.card img {
		width: 35px;
		height: 35px;
	}
	.card p {
		font-size: 0.9rem;
	}
}
</style>
<!-- end Simple Custom CSS and JS -->

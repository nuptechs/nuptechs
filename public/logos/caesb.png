}
.inov-secoes .desc { font-size: 18px; margin-bottom: 20px; text-align: justify; }
.inov-secoes ul.links {
  margin: 0 0 23px 18px;
  padding: 0;
}
.inov-secoes ul.links li {
  font-size: 17px;
  margin-bottom: 10px;
}
.inov-secoes ul.links a {
  color: #2176bf;
  font-weight: 700;
  text-decoration: none;
  font-size: 17px;
}
.inov-secoes ul.links a:hover { color: #0e4972; text-decoration: underline; }
.inov-secoes .contato {
  background: #f8fafc;
  border-left: 4px solid #2176bf;
  border-radius: 8px;
  padding: 14px 22px;
  margin: 26px 0 32px 0;
  font-size: 17px;
}
.inov-secoes .contato a { color: #2176bf; text-decoration: underline; font-weight: 700; }
.inov-secoes .noticias {
  margin-top: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 32px;
  justify-content: center;
}
.inov-secoes .noticia {
  background: #f8fafc;
  border-left: 4px solid #2176bf;
  border-radius: 9px;
  box-shadow: 0 2px 8px #2176bf10;
  padding: 16px 18px 16px 18px;
  margin-bottom: 0;
  display: flex;
  align-items: flex-start;
  gap: 22px;
  flex: 1 1 420px;
  min-width: 340px;
  max-width: 590px;
	
}
.inov-secoes .noticia img {
  width: 170px; 
  height: 115px; 
  border-radius: 8px; 
  border: 1.7px solid #e3e3e3;
  object-fit: cover;
  box-shadow: 0 1px 4px #0001;
}
.inov-secoes .noticia a {
  color: #2176bf;
  font-weight: bold;
  font-size: 18px;
  display: block;
  margin-bottom: 5px;
  text-decoration: none;
  line-height: 1.28;
}
.inov-secoes .noticia a:hover { color: #0e4972; text-decoration: underline; }
@media (max-width:1000px) {
  .inov-secoes .noticias { flex-direction: column; gap: 18px; }
  .inov-secoes .noticia { max-width: 100%; min-width: 0; }
}



:root {
  --primary: #005baa;
  --secondary: #3399ff;
  --gray: #f5f7fa;
  --border: #d0d7de;
  --radius: 12px;
  --font-main: Arial, Helvetica, sans-serif;
}
.caesb-pdi-container {
  font-family: var(--font-main);
  color: #222;
  line-height: 1.6;
  padding: 32px 2vw;
  font-size: 15px; 
}
.caesb-pdi-container h2 {
  color: var(--primary);
  margin-top: 0;
  font-size: 1.6em;
}
.caesb-pdi-container h3 {
  color: var(--secondary);
  margin-top: 1.2em;
  font-size: 1.25em;
}
.caesb-pdi-container section {
  margin-bottom: 2em;
}
.caesb-pdi-container a {
  color: var(--primary);
  text-decoration: underline;
  transition: color 0.2s;
  word-break: break-all;
}
.caesb-pdi-container a:hover {
  color: var(--secondary);
}
.caesb-pdi-container ul, .caesb-pdi-container ol {
  margin-left: 1.2em;
  margin-bottom: 0.7em;
}
.caesb-pdi-theme-block {
  margin-bottom: 1.5em;
  background: #eef4fb;
  border-left: 4px solid var(--primary);
  border-radius: var(--radius);
  padding: 1em 1.2em;
}
.caesb-pdi-theme-block h3 {
  margin-top: 0;
  font-size: 1.12em;
  color: var(--primary);
}
.caesb-pdi-theme-block ul {
  margin-bottom: 0;
}
.caesb-pdi-table-container {
  overflow-x: auto;
}
.caesb-pdi-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 1em;
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
}
.caesb-pdi-table th, .caesb-pdi-table td {
  padding: 0.7em 0.5em;
  text-align: left;
  border: 1px solid var(--border);
  font-size: 1em;
}
.caesb-pdi-table th {
  background: var(--gray);
  color: var(--primary);
  font-weight: bold;
  text-align: center;
}
.caesb-pdi-table td {
  background: #fff;
  text-align: center;
}
@media (max-width: 800px) {
  .caesb-pdi-container {
    padding: 10px 0.5vw;
  }
  .caesb-pdi-table, .caesb-pdi-table thead, .caesb-pdi-table tbody, .caesb-pdi-table th, .caesb-pdi-table td, .caesb-pdi-table tr {
    display: block;
  }
  .caesb-pdi-table th, .caesb-pdi-table td {
    padding: 0.7em 0.4em;
    border: none;
  }
  .caesb-pdi-table th {
    background: none;
    color: var(--primary);
    text-align: left;
  }
  .caesb-pdi-table tr {
    margin-bottom: 1.5em;
    background: #f9f9f9;
    border-radius: var(--radius);
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }
  .caesb-pdi-table td:before {
    content: attr(data-label);
    font-weight: bold;
    display: block;
    color: #555;
    margin-bottom: 0.3em;
    text-align: left;
  }
}






.caesbi-banner {
  background:  #e8f2fb;
  border-radius: 16px;
  box-shadow: 0 2px 16px #1e73be14;
  padding: 32px 32px 22px 32px;
  margin-bottom: 32px;
  font-family: Arial, Helvetica, sans-serif;
}

.caesbi-banner h1 {
  margin-top: 0;
  color: #1e73be;
  font-size: 1.7rem;
  margin-bottom: 14px;
}

.caesbi-banner p {
  font-size: 17px;
  color: #234769;
  margin: 0;
}

.caesbi-menu {
  display: flex;
  gap: 18px;
  margin-bottom: 36px;
  justify-content: center;
  flex-wrap: wrap;
}

.caesbi-menu a {
  flex: 1;
  min-width: 150px;
  text-align: center;
  background: #e8f2fb;
  border: 1px solid #d6e6f8;
  border-radius: 10px;
  box-shadow: 0 2px 10px #1e73be13;
  color: #1e73be;
  font-weight: bold;
  padding: 14px 0;
  font-size: 17px;
  text-decoration: none;
  transition: box-shadow .2s;
}

.caesbi-menu a:hover {
  box-shadow: 0 6px 22px #1e73be1a;
  background: #fafdff;
}

.caesbi-bloco {
  background: #fafdff;
  border-radius: 13px;
  border-left: 6px solid #1e73be;  
  border-right: none;
  border-top: none;
  border-bottom: none;
  box-shadow: 0 2px 11px #1e73be13;
  padding: 28px 28px 20px 28px;
  font-family: Arial, Helvetica, sans-serif;
  color: #234769;
  font-size: 17px;
  margin-bottom: 28px;
}

.caesbi-bloco.bg-azul {
  background: #e8f2fb;
}

.caesbi-bloco h2, .caesb-bloco h3 {
  color: #1e73be;
  margin: 0 0 10px 0;
  font-size: 1.4rem;
}

.caesbi-bloco ul {
  font-size: 17px;
  color: #234769;
  margin-left: 24px;
}

.caesbi-bloco .caesb-data {
  font-size: 17px;
  color: #234769;
  margin-top: 10px;
}



.caesb-bloco-branco {
  background: #fafdff;
  border-radius: 12px;
  box-shadow: 0 2px 11px #1e73be13;
  padding: 20px 24px;
  margin-bottom: 28px;
}
.caesb-titulo {
  color: #1e73be;
  margin-top: 0;
  font-size: 1.3rem;
}
.caesb-pub-lista {
  margin: 0;
  padding-left: 22px;
}
.caesb-pub-lista li {
  margin-bottom: 12px;
  font-size: 18px;
}
.caesb-pub-lista a {
  color: #1e4491;
  text-decoration: none;
  font-weight: bold;
  transition: color 0.14s;
}
.caesb-pub-lista a:hover {
  color: #0c314f;
  text-decoration: underline;
}
.caesb-pub-arquivo {
  font-weight: normal;
  color: #1e73be;
  font-size: 90%;
  margin-left: 4px;
}









.inova-projetos-icones {
  display: flex; flex-wrap: wrap; gap: 28px; margin-top: 26px;
  font-family: Arial, Helvetica, sans-serif;
  justify-content: center;
}
.inova-projeto-icone {
  background: #fff;
  border: 1.7px solid #d3e7fa;
  border-radius: 13px;
  box-shadow: 0 2px 12px #2176bf12;
  padding: 22px 26px 20px 19px;
  min-width: 340px; max-width: 450px; flex: 1 1 350px;
  display: flex; align-items: flex-start; gap: 16px;
  transition: box-shadow 0.22s;
}
.inova-projeto-icone:hover { box-shadow: 0 4px 22px #2176bf22; }
.inova-projeto-icone .icn {
  font-size: 36px; color: #2176bf; min-width: 42px; margin-top: 2px;
}
.inova-projeto-icone .texto {
  flex: 1 1 auto;
}
.inova-projeto-icone .titulo {
  font-weight: bold; color: #2176bf; font-size: 17px; margin-bottom: 3px;
}
.inova-projeto-icone .ano {
  color: #666; font-size: 14px; font-weight: normal; margin-left: 6px;
  text-decoration: underline;
}
.inova-projeto-icone .desc { font-size: 15px; margin-top: 7px; text-align: justify;}
@media (max-width:900px){.inova-projetos-icones{flex-direction:column;gap:13px;}.inova-projeto-icone{max-width:100%;min-width:0;}}


</style>

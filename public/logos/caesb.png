<style>
.small-box {
    background: #EFEFEF;
    color: #1e4491;
    text-align: center;
   	border-radius: 4px;
    font-weight: bold;
    font-size: 13px;
    cursor: pointer;
    width: 81px;
    height: 43px;
	margin-bottom: 40px;
}


.carrossel-wrapper {
	display: flex;
	align-items: center;
	overflow: hidden;
	background-color: #1E4491;
	padding: 10px;
	position: relative;
}
.container-wrapper {
	display: flex;
	align-items: stretch;
}
.static-link {
	text-decoration: none;
	display: flex;
	align-items: stretch;
}
.static-section {
	background-color: #295bc1;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-wrap: wrap;
	min-height: 100px;
	color: white;
}
.icon-img {
	width: 25px;
	height: 25px;
}
.static-title {
	font-size: 16px;
	text-align: center;
	margin-top:20px;
	
}
.arrow {
	color: #fff;
	font-size: 24px;
	cursor: pointer;
	user-select: none;
	z-index: 1;
}
.carrossel-container {
	display: flex;
	transition: transform 0.5s ease;
	will-change: transform;
	overflow-x: hidden;
	flex: 1;
	overflow-y: hidden;
}
.carrossel-item {
	list-style: none;
	margin: 0;
	padding: 10px;
	color: #000000;
	text-align: center;
	cursor: pointer;
	transition: background-color 0.3s;
	width: 164px;
	height: 150px;
	flex-shrink: 0;
	border-radius: 10px;
	box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	position: relative;
}


.carrossel-item svg {
	width: 50px;
	height: 50px;
	flex-shrink: 0;
	margin-bottom: 5px;
}
.carrossel-item img {
	width: 65px;
	height: 65px;
	flex-shrink: 0;
	margin-bottom: 5px;
	
}

.carrossel-item:not(:last-child)::after {
	content: '';
	position: absolute;
	right: -5px;
	top: 10px;
	bottom: 10px;
	width: 2px;
	background-color: #ffffff;
}
.carrossel-item:hover {
	background-color: #0B61A4;
}
.carrossel-item span {
	display: block;
	font-size: 14px;
	font-weight: normal;
	color: White;
}
/* Para telas de 1440px a 1920px */
@media (max-width: 1920px) and (min-width: 1440px) {
	.carrossel-wrapper {
		padding: 0;
	}
	.arrow {
		width: 30px;
		height: 30px;
	}
	.carrossel-item {
		width: 180px;
		height: 180px;
	}
	.carrossel-item .icon {
		width: 45px;
		height: 45px;
	}
	.carrossel-item span {
		font-size: 14px;
	}
}

@media (max-width: 1440px) {
	.carrossel-wrapper {
		padding: 5px;
	}
	.arrow {
		width: 25px;
		height: 25px;
	}
	.carrossel-item {
		width: 140px;
		height: 140px;
	}
	.carrossel-item .icon {
		width: 40px;
		height: 40px;
	}
	.carrossel-item span {
		font-size: 12px;
	}
}
@media (max-width: 768px) {
	.arrow {
		width: 20px;
		height: 20px;
	}
	.carrossel-item {
		width: 120px;
		height: 120px;
	}
	.carrossel-item .icon {
		width: 40px;
		height: 40px;
	}
	.carrossel-item span {
		font-size: 12px;
	}
}
@media (max-width: 480px) {
	.arrow {
		width: 15px;
		height: 15px;
	}
	.carrossel-item .icon {
		width: 40px;
		height: 40px;
	}
	.carrossel-item span {
		font-size: 8px;
	}
	.carrossel-item svg {
		width: 50px;
		height: 50px;
		flex-shrink: 0;
		margin-bottom: 5px;
	}
	.static-section {
	background-color: #295bc1;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 120px;
    height: 130px;
	
	color: white;
}
	
}
</style>

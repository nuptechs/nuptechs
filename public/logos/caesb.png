<style>
.grid-cdoc {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(208px, 1fr));
	gap: 10px;
}
.grid-doc img {
	width: 100%;
	height: auto;
}
@media (max-width: 768px) {
	.grid-doc img {
		width: 100%;
		height: auto;
	}
}
@media (max-width: 480px) {
	.grid-cdoc {
		grid-template-columns: repeat(auto-fill, minmax(94px, 1fr));
	}
	.grid-doc img {
		width: 100%;
		height: auto;
	}
}
</style>

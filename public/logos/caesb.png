<style>
.caesb-card {
  font-family: Arial, Helvetica, sans-serif;
  background: #fafdff;
  border-radius: 18px;
  box-shadow: 0 2px 18px #1e73be13;
  padding: 32px 26px;
  border: 2px solid #d6e6f7;
}

.caesb-card h2 {
  color: #1e73be;
  font-size: 24pt;
  margin-bottom: 18px;
  text-align: center;
}

.caesb-info-list {
  list-style: none;
  padding: 0;
  margin-bottom: 18px;
}

.caesb-info-list li {
  margin-bottom: 14px;
}

.caesb-info-list span.title {
  font-size: 15pt;
  font-weight: bold;
  color: #1e73be;
}

.caesb-info-list span.text {
  font-size: 13pt;
}



.caesb-actions {
  text-align: center;
  margin: 32px 0 18px 0;
}

.caesb-btn-main {
   display: inline-block;
  font-size: 16pt;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(90deg,#1e73be,#3ba7e2);
  padding: 16px 38px;
  border-radius: 28px;
  box-shadow: 0 2px 12px #1e73be29;
  text-decoration: none;
  margin-bottom: 12px;
  
}

.caesb-btn-sec {
  display: inline-block;
  font-size: 15pt;
  color: #1e73be;
  background: #e8f2fb;
  padding: 12px 28px;
  border-radius: 24px;
  margin-top: 6px;
  text-decoration: none;
  font-weight: bold;
  border: 2px solid #1e73be;
  
}

.caesb-card .caesb-obs {
  text-align: center;
  font-size: 11pt;
  color: #888;
}


.caesb-btn-sec:active,
.caesb-btn-sec:hover,
.caesb-btn-sec:focus{
	
	color: #1e73be;
	filter: none;
  text-decoration: none;
}


.caesb-termo-btns {
  margin: 14px 0 8px 0;
  text-align: left;
}

.caesb-termo-btn {
  display: inline-block;
  font-size: 15px;
  color: #fff;
  background: linear-gradient(90deg,#1e73be,#3ba7e2);
  padding: 13px 32px;
  border-radius: 24px;
  font-weight: bold;
  text-decoration: none;
  margin-bottom: 10px;
  margin-right: 12px;
  box-shadow: 0 1px 8px #1e73be22;
  border: none;
  transition: filter 0.2s, box-shadow 0.2s;
}

.caesb-termo-btn:hover,
.caesb-termo-btn:focus {
  filter: brightness(1.08);
  box-shadow: 0 2px 14px #2699fb33;
  color: #fff;
  text-decoration: none;
}





.caesb-btn-main:hover,
.caesb-btn-main:focus,
.caesb-btn-main:active{
  
  color: #fff;
  filter: none;
  text-decoration: none;
}</style>

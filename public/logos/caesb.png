<style>
#accessibility-bar {
	padding: 10px;
	display: flex;
	justify-content: space-around;
	align-items: center;
	width: 100%;
	top: 0;
	z-index: 9999;
}


#accessibility-bar a, #accessibility-bar button {
	background-color: transparent;
	border: none;
	padding: 5px 10px;
	text-decoration: none;
	color: #000;
	margin: 2px;
	cursor: pointer;
	font-size: 14px;
	/* Ajuste o tamanho da fonte aqui */
}
#accessibility-bar a:hover, #accessibility-bar button:hover {
	text-decoration: underline;
}
.high-contrast {
	background-color: #000;
	color: #ffee03;
}
@media (max-width: 1439px){
	#accessibility-bar {
		padding: 0px 140px 0px 0px;
		display: flex;
		justify-content: space-around;
		align-items: center;
		width: 100%;
		top: 0;
		z-index: 9999;
	}
	#accessibility-bar a, #accessibility-bar button {
		background-color: transparent;
		border: none;
		padding: 5px 10px;
		text-decoration: none;
		color: #000;
		margin: 2px;
		cursor: pointer;
		font-size: 14px;
		/* Ajuste o tamanho da fonte aqui */
	}
	#accessibility-bar a:hover, #accessibility-bar button:hover {
		text-decoration: underline;
	}
	.high-contrast {
		background-color: #000;
		color: #ffee03;
	}
}
</style>

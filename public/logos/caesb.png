<style>
.divider-container-gradient {
	display: flex;
	align-items: center;
	justify-content: center;
	margin: 0;
	padding: 0px 106px 10px 60px;
}
.divider-line-gradient {
	flex-grow: 1;
	height: 2px;
	background-color: #003366;
	

}


.divider-text-gradient {
	margin: 0 10px;
	padding: 5px 20px;
	background: linear-gradient(45deg, #003366, #006699);
	/* Gradiente */
	color: white;
	font-weight: bold;
	text-align: center;
	border-radius: 5px;
	font-size: 18px;
}

.elementor-widget-divider 
.elementor-divider__element {
    background: #005bab;
    color: white;
    padding: 11px 26px;
    border-radius: 8px;
    font-size: 18px;
    font-weight: bold;
}



@media (max-width: 1920px) {
	.divider-text-gradient {
		font-size: 20px;
		
		
	}
}
/* Media query para telas menores */
@media (max-width: 1440px) {
	.divider-container-gradient {
		padding: 10px 10px 10px 10px;
		/* Aumentar padding em telas maiores */
	}
	.divider-text-gradient {
		padding: 10px 30px;
		/* Aumentar padding em telas maiores */
		font-size: 18px;
		/* Ajustar tamanho da fonte */
	}
}
@media (max-width: 769px) {
	.divider-text-gradient {
		padding: 5px 10px;
		/* Reduzir padding em telas menores */
		font-size: 14px;
		/* Ajustar tamanho da fonte */
	}
}
@media (max-width: 480px) {

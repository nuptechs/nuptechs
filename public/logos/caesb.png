<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  const buttons = document.querySelectorAll(".accordion-btn");

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      const panelID = btn.getAttribute("aria-controls");
      const panel = document.getElementById(panelID);

      const isOpen = btn.getAttribute("aria-expanded") === "true";

      btn.setAttribute("aria-expanded", !isOpen);
      panel.classList.toggle("open");
    });
  });
});
</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const container = document.querySelector(".caesb-search-push");
    if (!container) return;

    const trigger = container.querySelector(".caesb-search-trigger");
    const form    = container.querySelector(".caesb-search-form");
    const input   = container.querySelector(".caesb-search-input");

    // Clique no ícone
    trigger.addEventListener("click", (e) => {
        e.preventDefault();

        // Se estiver fechado, só abre
        if (!container.classList.contains("active")) {
            container.classList.add("active");
            setTimeout(() => input.focus(), 200);
            return;
        }

        // Se já estiver aberto, clica de novo para buscar
        if (input.value.trim() !== "") {
            form.submit();
        } else {
            // se quiser, aqui pode fechar quando estiver vazio:
            // container.classList.remove("active");
        }
    });

    // Clique fora fecha a barra
    document.addEventListener("click", (e) => {
        if (!container.contains(e.target)) {
            container.classList.remove("active");
        }
    });
});
</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Obtém a data atual
        var now = new Date();
        
        // Nomes dos meses em português
        var monthNames = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
            "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
        
        // Definir 5 dias antes de mudar para o próximo mês
       var daysAfterSwitch = 3;
        var currentMonth = now.getMonth();
        var currentYear = now.getFullYear();
        
        // Verifica se estamos dentro dos primeiros 3 dias do mês
        if (now.getDate() <= daysAfterSwitch) {
            currentMonth -= 1; // Volta para o mês anterior
            if (currentMonth === -1) {
                currentMonth = 11; // Se for janeiro, volta para dezembro do ano anterior
                currentYear -= 1;  // Decrementa o ano
            }
        }
        
        // Formata o mês e ano atuais
        var formattedDate = "<strong>" + monthNames[currentMonth] + "</strong>/" + currentYear;

        // Atualiza os elementos com a classe 'update-date'
        var dateElements = document.querySelectorAll(".update-date");
        dateElements.forEach(function (element) {
            element.innerHTML = formattedDate;
        });
    });
</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener("DOMContentLoaded", function() {
    var cards = document.querySelectorAll(".card");
    var allContents = document.querySelectorAll(".card-content");

    

    cards.forEach(function(card) {
        card.addEventListener("click", function() {
            // Remove a classe 'active' de todos os cards
            cards.forEach(function(otherCard) {
                otherCard.classList.remove("active");
            });

            // Adiciona a classe 'active' ao card clicado
            this.classList.add("active");

            // Oculta todos os conteúdos
            allContents.forEach(function(content) {
                content.style.display = "none"; // Esconde todos os conteúdos
            });

            // Mostra o conteúdo correspondente
            var contentId = this.getAttribute("data-content");
            var contentToShow = document.getElementById(contentId);
            if (contentToShow) {
                contentToShow.style.display = "block"; // Mostra o conteúdo selecionado
            }
			
			var contentId = this.getAttribute("data-content");
            var contentToScrollTo = document.getElementById(contentId);
            
            if (contentToScrollTo) {
                // Faz o scroll suave para a seção correspondente
                contentToScrollTo.scrollIntoView({ behavior: "smooth" });
            }
        });
    });
});
</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener('DOMContentLoaded', function() {
	var tabs = document.querySelectorAll('.nav-tabs .btn');
	var tabPanes = document.querySelectorAll('.tab-pane');
	tabPanes[0].classList.add('active');
	// Display the first tab by default
	tabs.forEach(function(tab) {
		tab.addEventListener('click', function(event) {
			event.preventDefault();
			document.querySelector('.tab-pane.active').classList.remove('active');
			var target = tab.getAttribute('href');
			document.querySelector(target).classList.add('active');
			tabs.forEach(function(t) {
				t.classList.remove('active');
			}
						);
			tab.classList.add('active');
		}
							);
	}
				);
}
						 );
</script>

<style>
.slider-banner-container {
	display: grid;
	grid-template-columns: 2fr 1fr;
	/* 2/3 para o slider, 1/3 para os banners */
	grid-gap: 10px;
	/* Espaço entre o slider e os banners */
	align-items: stretch;
	/* Garante que ambos tenham a mesma altura */
}
.slider-wrapper {
	
	align-items: center;
}
.banner-wrapper {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.banner {
	flex: 1;
	/* Faz com que cada banner ocupe espaço igual */
	margin-bottom: 10px;
	/* Espaço entre os banners */
}
.banner img {
	width: 100%;
	height: auto;
}
/* Remove a margem do último banner */
.banner:last-child {
	margin-bottom: 0;
}
/* 2560px - Resolução muito alta, pode manter o layout normal */
@media (max-width: 2560px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
	}
	.banner img {
		width: 100%;
		height: 183px;
	}
}
@media (max-width: 1920px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
	}
	.banner img {
		width: 100%;
		height: 166px;
	}
	
}
@media (max-width: 1856px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
	}
	.banner img {
		width: 100%;
		height: 156px;
	}
	
}
@media (max-width: 1651px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
	}
	.banner img {
        width: 100%;
        height: 154px;
    }
	
}
@media (max-width: 1480px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
	}
	.banner img {
        width: 100%;
        height: 154px;
    }
	
}

/* 1440px - Telas de laptops grandes */
@media (max-width: 1440px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
		/* Mantém o layout lado a lado */
	}
	.banner-wrapper {
		margin-top: 0;
	}
	    .banner img {
        width: 100%;
        height: 154px;
    }
	

}
/* 1366px - Telas de laptops mais comuns */
@media (max-width: 1366px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
		/* Mantém o layout lado a lado */
	}
	.banner-wrapper {
		margin-top: 0;
	}
	    .banner img {
        width: 100%;
        height: 154px;
    }
}
/* 1024px - Laptops menores, tablets em landscape */
@media (max-width: 1024px) {
	.slider-banner-container {
		grid-template-columns: 2fr 1fr;
		/* Mantém o layout lado a lado */
	}
	.slider-wrapper {
		width: 100%;
	}
	.banner img {
        width: 100%;
        height: 85px;
    }
}
/* 768px - Tablets em portrait, smartphones grandes */
@media (max-width: 768px) {
	.slider-banner-container {
		display: flex;
		flex-direction: column;
		/* Empilha o slider e os banners */
	}
	.slider-wrapper {
        width: 93%;
        margin-left: 25px;
    }
	.banner-wrapper {
		width: 100%;
		margin-top: 10px;
	}
	.banner {
		margin-bottom: 10px;
	}
	.banner:last-child {
		margin-bottom: 0;
	}
	    .banner img {
        width: 93%;
        height: auto;
        margin-left: 24px;
    }
}
/* 425px - Smartphones pequenos */
@media (max-width: 425px) {
	.slider-banner-container {
		display: flex;
		flex-direction: column;
		/* Empilha o slider e os banners */
	}
	.slider-wrapper {
        width: 93%;
        margin-left: 12px;
    }
	.banner-wrapper {
		width: 100%;
		margin-top: 10px;
	}
	.banner {
		margin-bottom: 10px;
	}
	.banner:last-child {
		margin-bottom: 0;
	}
	    .banner img {
        width: 93%;
        height: auto;
        margin-left: 12px;
    }
}
</style>
<!-- end Simple Custom CSS and JS -->

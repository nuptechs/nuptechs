		<title>Ícones em Duas Linhas</title>
		<style>
			.icones_LAI {
				display: flex;
				align-items: center;
				justify-content: space-between; /* Altera para distribuir o espaço corretamente */
				list-style: none;
				padding: 0px;
				margin: 0px;

			}

			.icones_LAI li {
				margin: 20px;
				width: calc(50% - 40px); /* 50% do tamanho da linha menos margem */
				display: flex;
				justify-content: center;
			}

			.icones_LAI li img {
				height: 87px;
			}

			.icone_SINJ {
				width: 100%;
				display: flex;
				justify-content: flex-start; /* Alinha o SINJ à esquerda */
			}

			.icone_SINJ img {
				height: 60px !important; /* Reduzindo o tamanho do SINJ */
				
				margin-top:-25px!important;
			}
			.icone_DENU img {
				height: 80px !important; /* Reduzindo o tamanho do SINJ */
				margin-left: 20px; /* Adiciona espaço à esquerda */
				margin-top: -19px;
			}

			.icone_CON img {
				height: 240px !important; /* Forçando o tamanho da imagem do Conselho de Consumidores */
				
				margin-bottom: 0px !important;
			}

			/* Ajuste de altura da tela para tamanhos menores */
			@media (max-width: 1920px) {
				.icone_SINJ img {
					height: 60px !important;
					margin-top:9px!important;
				}
			}
			@media (max-width: 1440px) {
				.icones_LAI {
				display: flex;
				align-items: center;
				justify-content: space-between; /* Altera para distribuir o espaço corretamente */
				list-style: none;
				padding: 0px;
				margin: 0px;
				flex-wrap: wrap;
			}

			/* Ajustes para dispositivos menores */
			@media (max-width: 768px) {
				.icones_LAI {
					flex-direction: column;
					align-items: center;
				
				}

				.icones_LAI li {
					width: 100%;
				}

				.icone_CON img {
					height: 220px !important;
					margin-bottom: 0px !important;
					margin-top: -75px !important;
				}

				.icone_SINJ img {
					height: 60px !important;
					margin-top: -75px !important;
				}
			}
			@media (max-width: 428px) {
				.icones_LAI {
					flex-direction: column;
					align-items: center;
					margin-left:-150px ;
				}

		</style>
	</head>

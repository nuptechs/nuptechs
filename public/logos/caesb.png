<style>
.layout-servicos{
  display:grid!important;
  grid-template-columns: minmax(340px,369px) minmax(0,1fr);
  gap:20px;
  align-items:center;
}
.col-carrossel{order:1;}
.col-slide{order:2; min-width:0;}         

@media (max-width: 1440px){
  .layout-servicos{ grid-template-columns: 360px minmax(0,1fr);
  align-items:center;}
  
}
@media (max-width: 1200px){
  .layout-servicos{ grid-template-columns: 360px minmax(0,1fr); }
}
@media (max-width: 1060px){
  .layout-servicos{ grid-template-columns: 320px minmax(0,1fr); }
}


@media (max-width: 768px){
  .layout-servicos{ grid-template-columns: 1fr; 
	       width: 92% !important;
   }
	
}


.slider-wrapper1,
.slider-wrapper1 > div{
  width:100% !important;
  max-width:100% !important;
 background: #fff;
  border-radius: 10px;
  box-shadow: 0px 4px 10px rgba(0,0,0,0.08);
  overflow: hidden;
  padding: 0;
  
}
.slider-wrapper1 img,
.slider-wrapper1 video{
  max-width:100%;
  height:auto;
}


.novocarrossel-container {
            width: 100%;
            max-width: 500px;
            background: #295BC1;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            position: relative;
        }

        .novocarrossel-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #295BC1;
            padding: 15px;
            border-radius: 10px;
            font-weight: bold;
            color: #FFF;
            font-size: 18px;
            text-align: center;
        }

        .novocarrossel-header img {
            height: 46px;
            width: auto;
            margin-bottom: 5px;
        }

        .novocarrossel-carousel-wrapper {
            height: 360px;
            overflow: hidden;
            position: relative;
        }

        .novocarrossel-carousel {
            display: flex;
            flex-direction: column;
            transition: transform 1s ease-in-out;
        }

        .novocarrossel-service-item {
            display: flex;
            align-items: center;
            background: white;
            padding: 15px;
            margin: 7px 0;
            border-radius: 10px;
            box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
            font-weight: bold;
            font-size: 16px;
            color: #295bc1;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .novocarrossel-service-item:hover {
            transform: scale(1.01);
        }

        .novocarrossel-service-item a {
            text-decoration: none;
            color: #295bc1;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .novocarrossel-service-item i {
            font-size: 28px;
            margin-right: 15px;
            color: #295bc1;
        }

        .novocarrossel-more-services {
          display: inline-flex;              
          align-items: center;
          justify-content: center;
          gap: 10px;
          text-decoration: none;
          width: 100%;                        
          padding: 14px 18px;
          margin: 7px 0 0;
          background:white;
          font-size: 16px;
          font-weight: 700;
          line-height: 1;
          text-align: center;
          text-decoration: none;               
          border: 0;
          border-radius: 12px;
          box-shadow: 0 2px 6px rgba(0,0,0,.15);
          cursor: pointer;
          transition: transform .15s ease, background-color .15s ease, box-shadow .15s ease;
          -webkit-tap-highlight-color: transparent;
        }

        .novocarrossel-more-services a {
            text-decoration: none;
            color: #295bc1;
        }

        .novocarrossel-more-services:hover {
          background: #295bc1;
          transform: translateY(-1px) scale(1.01);
          box-shadow: 0 6px 16px rgba(0,0,0,.18);
          border: 1px solid #fff; 
        }

        .novocarrossel-more-services:hover a {
          color:white;
        }

        .novocarrossel-more-services:active {
          transform: translateY(0);
          box-shadow: 0 2px 6px rgba(0,0,0,.15);
        }

        .novocarrossel-more-services:focus-visible {
          outline: 3px solid #bfd2ff;          
          outline-offset: 2px;
        }

        .novocarrossel-header a {
          color: #fff;              
          text-decoration: none;    
        }

        .novocarrossel-header a:hover,
        .novocarrossel-header a:visited {
          color: #fff;              
        }



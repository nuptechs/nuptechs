<script>
document.addEventListener('DOMContentLoaded', function () {
	const carrosselContainer = document.getElementById('carrossel-container');
	const leftArrow = document.getElementById('left-arrow');
	const rightArrow = document.getElementById('right-arrow');
	let scrollStep = 200;
	// Pixels por passo de scroll, ajustado para corresponder à largura do item
	let scrollInterval = 2000;
	// Intervalo de tempo em ms entre cada passo de scroll
	let itemsVisible = 1;
	// Número de itens visíveis por vez
	function adjustCarrosselForScreenSize() {
		const screenWidth = window.innerWidth;
		if (screenWidth <= 480) {
			scrollStep = 120;
			itemsVisible = 4;
		}
		else if (screenWidth <= 768) {
			scrollStep = 120;
			itemsVisible = 4;
		}
		else if (screenWidth <= 1440) {
			scrollStep = 138;
			itemsVisible = 10;
		}
		else {
			scrollStep = 178;
			itemsVisible = 10;
		}
		 const carrosselItem = carrosselContainer.querySelector('.carrossel-item');
    const itemStyle = window.getComputedStyle(carrosselItem);
    const itemWidth = parseFloat(itemStyle.width);
    const itemMargin = parseFloat(itemStyle.marginLeft) + parseFloat(itemStyle.marginRight);

    const totalItemWidth = itemWidth + itemMargin;
    carrosselContainer.style.width = `${totalItemWidth * itemsVisible}px`;

	}
	adjustCarrosselForScreenSize();
	window.addEventListener('resize', adjustCarrosselForScreenSize);
	// Duplicar os itens para criar o efeito de carrossel infinito
	const carrosselItems = Array.from(carrosselContainer.children);
	carrosselItems.forEach(item => {
		const clone = item.cloneNode(true);
		carrosselContainer.appendChild(clone);
	}
						  );
	let autoScroll;
	// Função para mover o carrossel para a direita
	function scrollCarrossel() {
		if (carrosselContainer.scrollLeft >= carrosselContainer.scrollWidth / 2) {
			carrosselContainer.scrollLeft = 0;
		}
		carrosselContainer.scrollBy({
			left: scrollStep, behavior: 'smooth' }
								   );
	}
	leftArrow.addEventListener('click', function () {
		clearInterval(autoScroll);
		carrosselContainer.scrollBy({
			left: -scrollStep, behavior: 'smooth' }
								   );
		autoScroll = setInterval(scrollCarrossel, scrollInterval);
	}
							  );
	rightArrow.addEventListener('click', function () {
		clearInterval(autoScroll);
		carrosselContainer.scrollBy({
			left: scrollStep, behavior: 'smooth' }
								   );
		autoScroll = setInterval(scrollCarrossel, scrollInterval);
	}
							   );
	// Suporte a deslizar (touch)
	let startX;
	let scrollLeft;
	carrosselContainer.addEventListener('touchstart', (e) => {
		startX = e.touches[0].pageX - carrosselContainer.offsetLeft;
		scrollLeft = carrosselContainer.scrollLeft;
		clearInterval(autoScroll);
		// Pausar o scroll automático ao tocar
	}
									   );
	carrosselContainer.addEventListener('touchmove', (e) => {
		const x = e.touches[0].pageX - carrosselContainer.offsetLeft;
		const walk = (x - startX) * 0.5;
		// Ajuste a velocidade do scroll para ser mais lenta
		carrosselContainer.scrollLeft = scrollLeft - walk;
	}
									   );
	carrosselContainer.addEventListener('touchend', (e) => {
		autoScroll = setInterval(scrollCarrossel, scrollInterval);
		// Retomar o scroll automático ao soltar
	}
									   );
	// Pausar o scroll automático ao passar o mouse sobre o carrossel
	carrosselContainer.addEventListener('mouseenter', () => {
		clearInterval(autoScroll);
	}
									   );
	// Retomar o scroll automático ao remover o mouse do carrossel
	carrosselContainer.addEventListener('mouseleave', () => {
		autoScroll = setInterval(scrollCarrossel, scrollInterval);
	}
									   );
	autoScroll = setInterval(scrollCarrossel, scrollInterval);
}
						 );
</script>
<!-- end Simple Custom CSS and JS -->

<!-- start Simple Custom CSS and JS -->
<style>
.botao-conselho,
.btn {
     transition: transform 0.15s cubic-bezier(.4,0,.2,1), box-shadow 0.15s;
   
}

.botao-conselho:hover,
.btn:hover,
.botao-conselho:focus,
.btn:focus {
    transform: scale(1.06);
    
    z-index: 1;
}




.sanfonado-azul, 
.sanfonado-azul .elementor-tab-title, 
.sanfonado-azul .elementor-accordion-title, 
.sanfonado-azul .accordion-button,
.sanfonado-azul .wp-block-button__link {
    background-color: #1E73BE !important;
    color: #FFFFFF !important;
    border-radius: 16px;
    text-align: center !important;
    font-weight: bold !important;
    box-shadow: none !important;
}


.sanfonado-azul::after, 
.sanfonado-azul .elementor-accordion-icon, 
.sanfonado-azul .accordion-button::after {
    filter: invert(100%) brightness(200%) !important;
}


.sanfonado-azul:not(.collapsed), 
.sanfonado-azul .elementor-active, 
.sanfonado-azul .accordion-button:not(.collapsed) {
    background-color: #F7F7F7 !important;
    color: #FFFFFF !important;
	
	}
.sanfonado-azul .elementor-tab-content,
.sanfonado-azul .elementor-accordion-content,
.sanfonado-azul .accordion-body,
.sanfonado-azul .eael-accordion-content,
.sanfonado-azul .accordion-collapse {
    background: #F7F7F7 !important;
    border-radius: 0 0 16px 16px !important;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-top: none !important; 
    box-shadow: none !important; 
}

.calendario-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 14px;
  margin: 18px 0;
}
.calendario-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 2px 8px #0001;
  padding: 12px 9px 16px 9px;
  text-align: center;
}
.calendario-card .ano {
  font-size: 20px;
  color: #1E73BE;
  font-weight: 700;
  margin-bottom: 2px;
}
.calendario-card .tipo {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
}
.calendario-card .btn-download {
  background: #1E73BE;
  color: #fff;
  border: none;
  border-radius: 18px;
  font-size: 13px;
  padding: 5px 13px 5px 9px;
  font-weight: bold;
  cursor: pointer;
  text-decoration: none;
  transition: background .2s;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.calendario-card .btn-download:hover {
  background: #005fa3;
	transform: scale(1.06);
}

.btns-anos {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0;
  padding-left: 0;
  list-style: none;
}
.btns-anos li {
  margin: 0;
}
.btns-anos a {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #0070c9;
  color: #fff;
  border-radius: 14px;
  font-size: 15px;
  font-family: Arial, Helvetica, sans-serif;
  font-weight: 600;
  text-decoration: none;
  padding: 7px 17px;
  transition: background .2s;
  box-shadow: 0 2px 8px #0070c933;
}
.btns-anos a:hover {
  background: #005fa3;
}
.btns-anos .icon-year {
  font-size: 17px;
}



.botoes-atas {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0 12px 0;
  padding-left: 0;
  list-style: none;
}
.botoes-atas li { margin: 0; }
.botoes-atas a {
  background: #0070c9;
  color: #fff;
  border-radius: 14px;
  padding: 6px 14px;
  font-size: 15px;
  font-family: Arial, Helvetica, sans-serif;
  font-weight: 600;
  text-decoration: none;
  box-shadow: 0 2px 7px #0070c933;
  transition: background .18s;
}
.botoes-atas a:hover {
  background: #005fa3;
}


.noticias-cards {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 18px 0 24px 0;
  padding: 0;
  list-style: none;
}
.noticia-card {
  background: #f8fafc;
  border-left: 5px solid #2176bf;
  border-radius: 8px;
  padding: 11px 16px;
  box-shadow: 0 2px 8px #0001;
  display: flex;
  flex-direction: column;
}
.noticia-card a {
  color: #2176bf;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
  font-weight: bold;
  text-decoration: none;
  margin-bottom: 4px;
}
.noticia-card a:hover {
  text-decoration: underline;
  color: #0e4972;
}
.noticia-data {
  color: #888;
  font-size: 13px;
  font-family: Arial, Helvetica, sans-serif;
}





.card-contato-conselho {
  max-width: 480px;
  margin: 18px auto 28px auto;
  background: #f8fafc;
  border-left: 6px solid #2176bf;
  border-radius: 12px;
  box-shadow: 0 2px 14px #0002;
  padding: 22px 24px 20px 24px;
  font-family: Arial, Helvetica, sans-serif;
}
.card-contato-conselho h3 {
  color: #2176bf;
  font-size: 18px;
  text-align: center;
  margin-top: 0;
}
.card-contato-conselho ul {
  margin: 0;
  padding-left: 0;
  list-style: none;
}
.card-contato-conselho li {
  margin-bottom: 9px;
  font-size: 15px;
  display: flex;
  align-items: center;
  gap: 7px;
}
.card-contato-conselho .contato-tipo {
  color: #2176bf;
  font-weight: bold;
}
.card-contato-conselho .contato-valor {
  color: #444;
}

















.CardServ {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-bottom: 30px;
    }

    .CardServ a {
        background: #1E73BE;
        color: white;
        text-decoration: none;
        padding: 8px 15px;
        border-radius: 6px;

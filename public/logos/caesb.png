<style>
/* Estilos para o menu */
.laimenu {
	background-color: #004877;
	background: linear-gradient(to bottom, #1F89CD, #004877);
	box-shadow: 3px 3px 10px #888;
	padding: 15px;
	border-radius: 5px;
	width: 325px;
	margin-right: 20px;
	font-family: Arial; 
	font-size: 15px;
}
.laimenu ul {
	list-style-type: none;
	padding: 0;
}
.laimenu ul li {
	margin-bottom: 2px;
}
.laimenu ul li a {
	text-decoration: none;
	color: #f5f5f5;
	display: block;
	padding: 1px 10px 1px 10px;
	border-radius: 5px;
	width: 100%;
	box-sizing: border-box;
}
.laimenu ul li a:hover {
	color: #FF9200;
	background-color: #f5f5f5;
}
.laimenu ul li a:active {
	color: #FF9200;
}
.laimenu ul li a:focus {
	color: #FF9200;
}
.laimenu ul li a.selected {
	background-color: #002d5a;
	color: #fff;
}
.laisubmenu  {
	display: none;
	list-style-type: none;
	margin-left: 20px;
}
.laisubmenu li {
	margin-top: 5px;
}
.laisubmenu a {
	background: rgba(0,0,0,0);
}
.has-submenu.open > a {
	background-color: #002d5a;
	color: #fff;
}

.eael-simple-menu-container .eael-simple-menu li a {
   
    line-height: 39px;
    
}
</style>

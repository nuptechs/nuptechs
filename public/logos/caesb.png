<!-- start Simple Custom CSS and JS -->
<style>
.Rodapenovo {
	display: flex;
	background-color: #f8f8f8;
	padding: 0;
	position: relative;
}
.Rodapenovo .logo-section {
	background-color: #1E4491;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	width: 160px;
	padding: 0px 0px;
	margin-left: -20px;
	position: absolute;
	top: -90px;
	height: 430px;
}
.Rodapenovo .logo-section img {
	max-height: 20%;
	width: auto;
}
.Rodapenovo .content-section {
	display: flex;
	justify-content: center;
	flex: auto;
	padding: 0px 0px 0px 100px;
	background-color: #f8f8f8;
}
.Rodapenovo .content-section > div {
	margin-right: 40px;
}
.Rodapenovo .content-section > div:last-child {
	margin-right: 0px;
}
.Rodapenovo h4 {
	text-decoration: none;
	color: black;
	font-size: 16px;
	font-weight: bold;
	text-align: left;
}
.Rodapenovo ul {
	padding: 0;
	list-style-type: disc;
	/* Adiciona os pontos */
	margin-left: 0px;
	/* Ajusta o alinhamento dos pontos */
}
.Rodapenovo ul li {
	margin-bottom: 5px;
	text-align:left;
}
.Rodapenovo ul li a {
	color: #555;
	text-decoration: none;
}
.Rodapenovo ul li a:hover {
	text-decoration: underline;
}
footer {
	background-color: #f8f8f8;
	padding: 10px;
	text-align: center;
}
